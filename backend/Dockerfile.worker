# ── Stage 1: build wheels ──────────────────────────────────────────────────
FROM python:3.12-alpine AS builder

RUN apk add --no-cache build-base libffi-dev openssl-dev \
    pango-dev cairo-dev gdk-pixbuf-dev fontconfig-dev

WORKDIR /build
COPY requirements.txt .
# Install app deps + ansible in one layer
RUN pip install --no-cache-dir --prefix=/deps -r requirements.txt && \
    pip install --no-cache-dir --prefix=/deps ansible

# ── Stage 2: final worker image ────────────────────────────────────────────
FROM python:3.12-alpine

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Runtime: git, ssh client (ansible), sshpass (password-based SSH), curl
# pango/cairo/fontconfig: required by weasyprint for PDF rendering
RUN apk add --no-cache git curl bash openssh-client sshpass \
    pango cairo gdk-pixbuf fontconfig ttf-freefont

# Copy installed packages from builder
COPY --from=builder /deps /usr/local

WORKDIR /app
COPY . .
