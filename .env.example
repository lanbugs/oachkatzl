# ============================================================
#  Oachkatzl — Example Environment Configuration
#  Copy this file to .env and fill in the required values.
#  Lines starting with # are comments and are ignored.
# ============================================================


# ------------------------------------------------------------
#  Database
# ------------------------------------------------------------

# MongoDB connection string (Docker Compose default shown)
OACHKATZL_MONGO_URI=mongodb://mongo:27017/oachkatzl


# ------------------------------------------------------------
#  Redis  (broker · result backend · SocketIO backplane · pub/sub)
# ------------------------------------------------------------

# Single URL used by all Redis consumers unless overridden below
OACHKATZL_REDIS_URL=redis://redis:6379/0

# Override Celery broker independently (defaults to OACHKATZL_REDIS_URL)
#OACHKATZL_CELERY_BROKER_URL=redis://redis:6379/0

# Override Celery result backend independently (defaults to OACHKATZL_REDIS_URL)
#OACHKATZL_CELERY_RESULT_BACKEND=redis://redis:6379/0


# ------------------------------------------------------------
#  Security  — REQUIRED in production
# ------------------------------------------------------------

# Secret used to sign JWT tokens.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
OACHKATZL_JWT_SECRET=change-me-in-production-use-a-long-random-string

# Fernet key used to encrypt secrets stored in the database.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# WARNING: losing this key makes all stored secrets unrecoverable.
OACHKATZL_ENCRYPTION_KEY=


# ------------------------------------------------------------
#  Authentication
# ------------------------------------------------------------

# JWT access-token lifetime in hours (default: 24)
OACHKATZL_JWT_EXPIRY_HOURS=24

# Issuer name shown in authenticator apps (e.g. Google Authenticator)
OACHKATZL_TOTP_ISSUER=Oachkatzl

# Enforce 2FA/TOTP for every user (true/false)
OACHKATZL_REQUIRE_2FA=false

# Allowed CORS origins (comma-separated); add your frontend URL in production
OACHKATZL_CORS_ORIGINS=http://localhost:5173,http://localhost:8080


# ------------------------------------------------------------
#  Bootstrap admin account  (created on first start if absent)
# ------------------------------------------------------------

OACHKATZL_ADMIN_USER=admin
# Leave at "changeme" to have a random password printed to the container log on first start
OACHKATZL_ADMIN_PASSWORD=changeme
OACHKATZL_ADMIN_EMAIL=admin@localhost


# ------------------------------------------------------------
#  Execution
# ------------------------------------------------------------

# Working directory on the worker for git clones
OACHKATZL_GIT_WORKDIR=/tmp/oachkatzl


# ------------------------------------------------------------
#  LDAP / Active Directory  (optional)
# ------------------------------------------------------------

#OACHKATZL_LDAP_URL=ldap://dc.example.com:389
#OACHKATZL_LDAP_BIND_DN=CN=svc-oachkatzl,OU=ServiceAccounts,DC=example,DC=com
#OACHKATZL_LDAP_BIND_PASSWORD=
#OACHKATZL_LDAP_BASE_DN=DC=example,DC=com
# {username} is replaced with the login name at runtime
#OACHKATZL_LDAP_USER_FILTER=(sAMAccountName={username})


# ------------------------------------------------------------
#  SMTP / E-Mail notifications
#  Used by the Mailpit test server in Docker Compose dev setup.
#  Replace with real credentials for production.
# ------------------------------------------------------------

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_TLS=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=oachkatzl@localhost
